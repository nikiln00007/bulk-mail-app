{
  "name": "bulkmailpro",
  "version": "1.0.0",
  "description": "Full Stack MERN Bulk Mail Application",
  "type": "module",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "install:all": "cd client && npm install && cd ../server && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "validator": "^13.12.0"
  },
  "engines": {
    "node": ">=18.x"
  }
}
